  "skills": [
    {
      "name": "Death Scythe",
      "description": "Winning an Attack matchup deals 22 bonus damage.",
      "rules": [
        {
          "when": "on_attack_win",
          "do": [
            {
              "op": "bonus_damage",
              "value": 22
            }
          ]
        }
      ]
    },
    {
      "name": "Dark Pursuit",
      "description": "Deals 25% more damage to an opponent below 40% HP.",
      "rules": [
        {
          "when": "passive",
          "if": [
            {
              "cond": "enemy_hp_below_pct",
              "value": 0.4
            }
          ],
          "do": [
            {
              "op": "bonus_damage_pct",
              "value": 25
            }
          ]
        }
      ]
    },
    {
      "name": "Death Spiral",
      "description": "Consecutive Attack wins build toward a crit — three in a row and the next one lands.",
      "rules": [
        {
          "when": "on_attack_win",
          "do": [
            {
              "op": "add_counter",
              "name": "spiral",
              "value": 1,
              "max": 3
            }
          ]
        },
        {
          "when": "on_attack_win",
          "if": [
            {
              "cond": "counter_at_least",
              "name": "spiral",
              "value": 3
            }
          ],
          "do": [
            {
              "op": "consume_counter",
              "name": "spiral",
              "value": 3
            },
            {
              "op": "guaranteed_crit",
              "value": 1
            }
          ]
        },
        {
          "when": "on_attack_loss",
          "do": [
            {
              "op": "reset_counter",
              "name": "spiral"
            }
          ]
        }
      ]
    }
  ],
