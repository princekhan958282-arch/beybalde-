  "description": "A ruthless left-spin destroyer armed with four metal dragons. Every strike builds violent momentum toward a devastating 5th-hit uppercut or an airborne Dragon Scream finisher.",
  "burst_height": "Mid",
  "type": "Attack",
  "stats": {
    "attack": 112,
    "defense": 31,
    "stamina": 92,
    "special": 120,
    "hp": 75
  },
  "ability": {
    "name": "Bloody Squall",
    "trigger": "on_attack_win",
    "description": "Each Attack win builds a Bloody Squall stack (+14 ATK, max 4) with a 40% chance to deal +50% ATK bonus damage, while dealing 40% of damage dealt as self-recoil. At 4 stacks, the 5th hit deals 150% damage with a guaranteed crit and resets the cycle — or all 4 stacks can be consumed in Dragon Scream for 200 base damage, +100% bonus damage, a critical hit, and 50% defense ignore. VS Left-Spin: gains +0.3 extra stamina drain, +15 Stamina, +8 Defense, and -7 recoil.",
    "rules": [
      {
        "when": "setup",
        "if": [
          {
            "cond": "enemy_spin_is",
            "value": "Left"
          }
        ],
        "do": [
          {
            "op": "buff",
            "stat": "stamina",
            "amount": 15,
            "turns": 99
          },
          {
            "op": "buff",
            "stat": "defense",
            "amount": 8,
            "turns": 99
          },
          {
            "op": "modify_recoil_flat",
            "value": -7
          },
          {
            "op": "log",
            "text": "🌀 Left-Spin Clash — Longinus equalizes spin (+15 STA, +8 DEF, +0.3 Stamina Drain, -7 Recoil)!"
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_attack_win",
        "do": [
          {
            "op": "add_counter",
            "name": "squall_cycle",
            "amount": 1,
            "max": 5
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_attack_win",
        "if": [
          {
            "cond": "counter_below",
            "name": "squall_cycle",
            "value": 5
          }
        ],
        "do": [
          {
            "op": "stacking_buff",
            "stat": "attack",
            "per_stack": 14,
            "max": 4,
            "name": "squall"
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_attack_win",
        "chance": 0.4,
        "if": [
          {
            "cond": "counter_below",
            "name": "squall_cycle",
            "value": 5
          }
        ],
        "do": [
          {
            "op": "bonus_damage_stat",
            "stat": "attack",
            "scale": 0.5,
            "label": "Bloody Squall"
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_attack_win",
        "if": [
          {
            "cond": "counter_at_least",
            "name": "squall_cycle",
            "value": 5
          }
        ],
        "do": [
          {
            "op": "bonus_damage_pct",
            "value": 50
          },
          {
            "op": "guaranteed_crit",
            "turns": 1
          },
          {
            "op": "reset_counter",
            "name": "squall"
          },
          {
            "op": "reset_counter",
            "name": "squall_cycle"
          },
          {
            "op": "log",
            "text": "🐉 FOUR-DRAGON UPPER (5th Hit) — 150% damage critical strike! Bloody Squall cycle resets!"
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_damage_dealt",
        "do": [
          {
            "op": "recoil_percent_of_damage",
            "percent": 40
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_damage_dealt",
        "if": [
          {
            "cond": "enemy_spin_is",
            "value": "Left"
          }
        ],
        "do": [
          {
            "op": "drain_stamina",
            "value": 0.3
          }
        ],
        "_name": "Bloody Squall"
      },
      {
        "when": "on_special",
        "if": [
          {
            "cond": "counter_at_least",
            "name": "squall",
            "value": 4
          }
        ],
        "do": [
          {
            "op": "bonus_damage_pct",
            "value": 100
          },
          {
            "op": "guaranteed_crit",
            "turns": 1,
            "special": true
          },
          {
            "op": "ignore_defense_pct",
            "value": 50
          },
          {
            "op": "reset_counter",
            "name": "squall"
          },
          {
            "op": "reset_counter",
            "name": "squall_cycle"
          },
          {
            "op": "log",
            "text": "🐉 AWAKENED DRAGON SCREAM — All 4 stacks unleashed! +100% damage, Critical Hit, and 50% Defense Ignore!"
          }
        ],
        "_name": "Dragon Scream"
      }
    ]
  },
