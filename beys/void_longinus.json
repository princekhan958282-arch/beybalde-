    {
      "name": "Void",
      "trigger": "passive",
      "description": "Against a RIGHT-spin opponent only, the void opens: the enemy loses 20% of its Defense, and Void Longinus spins almost frictionlessly — Attack and Defense cost 0.5 less Stamina, and Void Crash costs 1 less. Against a left-spin opponent the ability lies dormant.",
      "rules": [
        {
          "when": "passive",
          "_name": "Void",
          "if": [
            {
              "cond": "enemy_spin_is",
              "value": "right"
            }
          ],
          "once": "battle",
          "do": [
            {
              "op": "enemy_debuff_pct",
              "stat": "defense",
              "value": 0.2,
              "turns": 999
            },
            {
              "op": "stamina_cost_reduction",
              "value": 0.2
            }
          ],
          "_note": "once:battle + a 999-turn duration makes this a STANDING debuff. As a plain passive it would re-apply every round and StatusManager.add_buff appends, so the enemy would lose 20% again and again until their Defense hit zero. The stamina side is a fraction because stamina_cost_reduction is proportional: 0.20 of the 2.2 Attack/Defense cost is ~0.44, and of the 4.4 Special cost is ~0.88 — the closest the existing op gets to the authored -0.5 / -1.0."
        }
      ]
    }
