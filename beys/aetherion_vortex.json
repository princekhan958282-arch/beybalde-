  "special_move": {
    "name": "Vortex Judgment: Cataclysm Break",
    "description": "Two judgments out of the eye of the vortex. The first lands for 70. The second reads how strongly Aetherion Vortex is still spinning — 60, plus 50 for every point of Stamina above 7, to a maximum of three stacks.",
    "hits": 2,
    "damage_per_hit": [
      70,
      60
