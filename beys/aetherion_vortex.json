    "total_damage": 130,
    "per_hit_bonus": [
      null,
      {
        "source": "own_stamina_above",
        "threshold": 7,
        "per": 50,
        "max_stacks": 3,
        "_note": "8 stamina = 1 stack = +50. 10 or more = 3 stacks = +150, the cap."
      }
    ],
    "flavour_texts": [
      "🌀 **VORTEX JUDGMENT** — the eye opens!",
      "💥 **CATACLYSM BREAK** — the vortex reads your spin and answers!"
    ]
  },
  "abilities": [
    {
      "name": "Aether Drain",
      "trigger": "on_attack_hit",
      "description": "Every landed Attack draws in the aether: +1 stack (+3 Attack, +3 Defense) and 5 HP restored. At 10 stacks the vortex collapses into OVERDRIVE — +25% total damage for 5 turns — and the stacks reset to begin again.",
      "rules": [
        {
          "when": "on_attack_hit",
          "_name": "Aether Drain",
          "do": [
            {
              "op": "stacking_buff",
              "name": "aether_drain",
              "stat": "attack",
              "per_stack": 3,
              "max": 10,
              "turns": 999
            },
            {
              "op": "buff",
              "stat": "defense",
              "amount": 3,
              "turns": 999
            },
            {
              "op": "heal",
              "value": 5
            }
          ],
          "_note": "Only the ATK line owns the counter; the DEF line rides alongside it so the stack is counted exactly once."
        },
        {
          "when": "on_attack_hit",
          "_name": "Aether Drain — OVERDRIVE",
          "if": [
            {
              "cond": "counter_at_least",
              "name": "aether_drain",
              "value": 10
            }
          ],
          "do": [
            {
              "op": "set_mode",
              "name": "Overdrive"
            },
            {
              "op": "dmg_amp",
              "value": 0.25,
              "turns": 5
            },
            {
              "op": "reset_counter",
              "name": "aether_drain"
            }
          ],
          "_note": "dmg_amp carries `turns`, so the amp is subtracted again when it expires. Without that it would be permanent and an Overdrive that never ends is not an Overdrive."
        }
      ]
    },
    {
